# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Site identity
IBVAP_SITE_ID=BOP-DEMO-01

# MQTT (Mosquitto)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=ibvap
MQTT_PASSWORD=change-me

# Frigate
FRIGATE_API_URL=http://frigate:5000
FRIGATE_RTSP_PASSWORD=change-me

# Database (SQLite at the edge, PostgreSQL at the centre)
IBVAP_DATABASE_URL=sqlite:///./data/ibvap.db

# Border rules (zones, tripwires, per-camera rules)
IBVAP_RULES_PATH=config/rules.yaml

# Evidence store: per-alert snapshot + clip (5 s before to 10 s after the alert)
IBVAP_EVIDENCE_ENABLED=true
IBVAP_EVIDENCE_MAX_MB=1000
IBVAP_EVIDENCE_RETENTION_DAYS=2
IBVAP_CLIP_PRE_S=5
IBVAP_CLIP_POST_S=10

# Evidence encryption key (base64, 32 bytes). Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
IBVAP_EVIDENCE_KEY=

# Jev / TypeSafe AI (leave empty to run rules-only)
JEV_API_URL=
JEV_API_KEY=
JEV_TIMEOUT_MS=500
